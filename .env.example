# Server environment of @maze/web (plan §7.9).
#
# This file is documentation only. The app does not read a shared .env file: scripts/dev-up.sh
# reads deployments/local-<port>.json and passes these variables on the command line.
# The test-hook flags listed in plan §7.9 are deliberately absent here. They are passed on the
# command line only and must never be written to any .env* file.

# Chain. The browser gets these from GET /api/config at runtime, never from the build.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Written to deployments/local-<port>.json by scripts/deploy-local.ts.
MAZEBET_ADDRESS=

# Anvil default account #1 (public, well-known test key): server signer and relayer.
SERVER_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Append-only event log directory (events.jsonl).
MAZE_DATA_DIR=.data

# Optional overrides of the table's timing, in chain seconds.
# MAZE_IDLE_TIMEOUT_SEC=120
# MAZE_MAX_GAME_SEC=900

# Offers the Anvil dev wallet in the UI. Effective only on chain 31337, and the browser only
# learns it through /api/config (devWallet).
NEXT_PUBLIC_ENABLE_DEV_WALLET=1

# Next.js build output directory. Use a distinct value per parallel build or scenario.
NEXT_DIST_DIR=.next
